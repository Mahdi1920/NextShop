{
  "name": "admin",
  "projectType": "application",
  "sourceRoot": "e-commerceadmin/app",
  "tags": ["scope:admin", "type:application"],
  "implicitDependencies": ["frontend-shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": { "command": "npm run build", "cwd": "e-commerceadmin" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "npm run dev", "cwd": "e-commerceadmin" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "e-commerceadmin" }
    }
  }
}
